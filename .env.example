# Blank names kept so older local files stay recognizable. Active apps do not read them.
VITALITY_SUPPLY_DATABASE_URL=
VITALITY_STOREFRONT_DATABASE_URL=

# Dedicated local-only database for Tessera API integration tests; never use production here
