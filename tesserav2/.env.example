# Copy to .env.local for local use, or configure values in the hosting secret
# manager. Keep values blank in Git. Do not commit actual keys or personal data.

# Tessera core
DATABASE_URL=
FATHER_NATAL_CHART_JSON=
TESSERACT_ADMIN_KEY=
SIGIL_ADMIN_KEY=
SOVEREIGN_ADMIN_TOKEN=
SESSION_SECRET=
# Required for the colonial cipher and lattice frequency bands. Minimum length 32.
# Leave blank in git. There is no default and no bypass. Unset or too short disables those features.
COLONIAL_MASTER_SECRET=
# Legacy colonial XOR path. Minimum length 32. Leave blank in git.
# Unset or too short disables that path. There is no default and no bypass.
COLONIAL_LEGACY_XOR_KEY=
TESSERA_LLM_BASE_URL=
TESSERA_LLM_API_KEY=
TESSERA_LLM_MODEL=
TESSERA_EMBED_MODEL=
VITE_TESSERA_LLM_MODEL=
# GLM-5 Pen adapter: selected by owner, disabled until endpoint and gates pass
TESSERA_PEN_ENABLED=0
TESSERA_PEN_MODEL=GLM-5

# Auth/payment integrations (only when enabled)
BETTER_AUTH_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
WEBHOOK_SECRET=
REPLIT_CONNECTORS_HOSTNAME=
GROK_CONNECTOR_ACCESS_TOKEN=

# Optional provider keys
GITHUB_TOKEN=
MOLTBOOK_API_KEY=
NASA_API_KEY=
TESSERA_API_KEY=
FORUM_ADMIN_TOKEN=
AGENT_PRIVATE_KEY=

# Network/runtime settings (non-secret values)
PORT=
# Loopback port the preview desk uses to check the owner session on the api-server.
# Integer from 1 to 65535. Unset, blank, or invalid fails closed in the gate.
# There is no fallback in the gate.
# The Vite dev server copies a valid TESSERA_API_PORT into this value when it
# is unset, and only while serving in development. It does not invent a port.
# Production preview and builds leave it unset. An invalid value is left unchanged.
# API_SERVER_PORT on the API process is inert for the desk gate. Without a
# preview service the gate returns 503.
# Optional extra held-name substring. Unset keeps the built-in markers only.
# SOVEREIGN_HELD_NAME_PATTERN=
# API_SERVER_PORT=5000
BASE_PATH=
# Optional root suite overrides
TESSERA_WEB_PORT=
TESSERA_API_PORT=
# API server when PORT is taken: 1 moves to the next free port, 0 exits with an error.
# Unset: exits with an error, except on Replit where the old fallback stays.
TESSERA_PORT_FALLBACK=
MOCKUP_SANDBOX_PORT=
TESSERA_BASE_PATH=
MOCKUP_SANDBOX_BASE_PATH=
BASE_URL=
VITE_API_BASE=
VITE_API_URL=
VITE_PUBLIC_HOSTNAME=
VITE_PUBLIC_SITE_URL=
ALLOWED_EXTERNAL_DOMAINS=
SOVEREIGN_ALLOWED_ORIGINS=
SOLANA_RPC_URL=

# Dedicated local-only database for Tessera API integration tests; never use production here
TESSERA_TEST_DATABASE_URL=
TESSERA_TEST_FATHER_NATAL_CHART_JSON=

# Gitbook MCP connector. Leave the token blank in git. See artifacts/gitbook-mcp/README.md.
GITBOOK_GITHUB_TOKEN=
GITBOOK_GITHUB_OWNER=
GITBOOK_GITHUB_REPO=
# Loopback only: 127.0.0.1, ::1, or localhost. Any other value refuses to start.
GITBOOK_HTTP_HOST=
GITBOOK_HTTP_PORT=
# Empty is read-only (no draft pull requests). A per-call lane cannot override this.
GITBOOK_AGENT_LANE=
