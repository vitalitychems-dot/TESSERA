modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
TESSERA_ENABLE_COLONIAL_FALLBACK = "0"
TESSERA_ENABLE_RICK_LOOP = "0"
TESSERA_PORT_FALLBACK = "0"
FORUM_WORKER_URL = "Where do I find this forum summons V1 service"
