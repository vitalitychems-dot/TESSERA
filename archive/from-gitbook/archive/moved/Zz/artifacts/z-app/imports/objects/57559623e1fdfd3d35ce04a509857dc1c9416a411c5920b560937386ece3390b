@import "tailwindcss";
@import "tw-animate-css";
@plugin "@tailwindcss/typography";

@custom-variant dark (&:is(.dark *));

@theme inline {
  --color-background: hsl(var(--background));
  --color-foreground: hsl(var(--foreground));
  --color-border: hsl(var(--border));
  --color-input: hsl(var(--input));
  --color-ring: hsl(var(--ring));
  --color-card: hsl(var(--card));
  --color-card-foreground: hsl(var(--card-foreground));
  --color-card-border: hsl(var(--card-border));
  --color-popover: hsl(var(--popover));
  --color-popover-foreground: hsl(var(--popover-foreground));
  --color-popover-border: hsl(var(--popover-border));
  --color-primary: hsl(var(--primary));
  --color-primary-foreground: hsl(var(--primary-foreground));
  --color-primary-border: var(--primary-border);
  --color-secondary: hsl(var(--secondary));
  --color-secondary-foreground: hsl(var(--secondary-foreground));
  --color-secondary-border: var(--secondary-border);
  --color-muted: hsl(var(--muted));
  --color-muted-foreground: hsl(var(--muted-foreground));
  --color-muted-border: var(--muted-border);
  --color-accent: hsl(var(--accent));
  --color-accent-foreground: hsl(var(--accent-foreground));
  --color-accent-border: var(--accent-border);
  --color-destructive: hsl(var(--destructive));
  --color-destructive-foreground: hsl(var(--destructive-foreground));
  --color-destructive-border: var(--destructive-border);
  --color-chart-1: hsl(var(--chart-1));
  --color-chart-2: hsl(var(--chart-2));
  --color-chart-3: hsl(var(--chart-3));
  --color-chart-4: hsl(var(--chart-4));
  --color-chart-5: hsl(var(--chart-5));
  --color-sidebar: hsl(var(--sidebar));
  --color-sidebar-foreground: hsl(var(--sidebar-foreground));
  --color-sidebar-border: hsl(var(--sidebar-border));
  --color-sidebar-primary: hsl(var(--sidebar-primary));
  --color-sidebar-primary-foreground: hsl(var(--sidebar-primary-foreground));
  --color-sidebar-primary-border: var(--sidebar-primary-border);
  --color-sidebar-accent: hsl(var(--sidebar-accent));
  --color-sidebar-accent-foreground: hsl(var(--sidebar-accent-foreground));
  --color-sidebar-accent-border: var(--sidebar-accent-border);
  --color-sidebar-ring: hsl(var(--sidebar-ring));
  --font-sans: var(--font-sans-family);
  --font-serif: Georgia, serif;
  --font-mono: var(--font-mono-family);
  --radius-sm: calc(var(--radius) - 4px);
  --radius-md: calc(var(--radius) - 2px);
  --radius-lg: var(--radius);
  --radius-xl: calc(var(--radius) + 4px);
}

:root {
  --font-sans-family: 'Inter', system-ui, sans-serif;
  --font-display: 'Orbitron', 'Space Grotesk', sans-serif;
  --font-mono-family: 'JetBrains Mono', monospace;

  --background: 250 15% 6%;
  --foreground: 220 40% 96%;
  --card: 250 14% 8%;
  --card-foreground: 220 40% 96%;
  --popover: 250 14% 12%;
  --popover-foreground: 220 40% 96%;
  --primary: 191 97% 50%;
  --primary-foreground: 250 20% 4%;
  --secondary: 255 12% 16%;
  --secondary-foreground: 220 40% 96%;
  --muted: 255 10% 18%;
  --muted-foreground: 230 12% 55%;
  --accent: 265 16% 18%;
  --accent-foreground: 220 40% 96%;
  --destructive: 0 84% 60%;
  --destructive-foreground: 220 40% 96%;
  --border: 255 10% 16%;
  --input: 255 12% 14%;
  --ring: 191 97% 50%;
  --radius: 0.75rem;
  --card-border: 255 10% 16%;
  --popover-border: 255 10% 16%;
  --primary-border: hsl(191 97% 50% / 0.2);
  --secondary-border: hsl(255 12% 24% / 0.3);
  --muted-border: hsl(255 10% 22% / 0.3);
  --accent-border: hsl(265 16% 24% / 0.3);
  --destructive-border: hsl(0 84% 60% / 0.3);
  --sidebar-primary-border: hsl(191 97% 50% / 0.2);
  --sidebar-accent-border: hsl(265 14% 16% / 0.3);
  --sidebar: 250 15% 4%;
  --sidebar-foreground: 220 40% 96%;
  --sidebar-border: 255 10% 14%;
  --sidebar-primary: 191 97% 50%;
  --sidebar-primary-foreground: 250 20% 4%;
  --sidebar-accent: 265 14% 10%;
  --sidebar-accent-foreground: 220 40% 96%;
  --sidebar-ring: 191 97% 50%;
  --chart-1: 191 97% 50%;
  --chart-2: 265 80% 60%;
  --chart-3: 155 75% 48%;
  --chart-4: 35 92% 55%;
  --chart-5: 345 78% 55%;
  --button-outline: rgba(0,0,0, .10);
  --badge-outline: rgba(0,0,0, .05);
  --opaque-button-border-intensity: -8;
  --elevate-1: rgba(255,255,255, .03);
  --elevate-2: rgba(255,255,255, .08);
  --shadow-2xs: 0px 2px 0px 0px transparent;
  --shadow-xs: 0px 2px 0px 0px transparent;
  --shadow-sm: 0px 2px 0px 0px transparent, 0px 1px 2px -1px transparent;
  --shadow: 0px 2px 0px 0px transparent, 0px 1px 2px -1px transparent;
  --shadow-md: 0px 2px 0px 0px transparent, 0px 2px 4px -1px transparent;
  --shadow-lg: 0px 2px 0px 0px transparent, 0px 4px 6px -1px transparent;
  --shadow-xl: 0px 2px 0px 0px transparent, 0px 8px 10px -1px transparent;
  --shadow-2xl: 0px 2px 0px 0px transparent;
  --tracking-normal: 0em;
  --spacing: 0.25rem;
  --chart-tooltip-bg: rgba(14,10,30,0.95);
  --chart-tooltip-fg: #e2e8f0;
  --depth-1: rgba(255,255,255, 0.03);
  --depth-2: rgba(255,255,255, 0.06);
  --depth-3: rgba(255,255,255, 0.10);
  --glow-sm: 0 0 8px;
  --glow-md: 0 0 20px;
  --glow-lg: 0 0 40px;
  --aurora-1: rgba(168,85,247,0.08);
  --aurora-2: rgba(34,211,238,0.06);
  --aurora-3: rgba(245,158,11,0.05);
  --aurora-4: rgba(236,72,153,0.04);
  --surface-glass: rgba(8, 5, 18, 0.55);
  --surface-glass-hover: rgba(12, 8, 24, 0.65);
  --surface-elevated: rgba(14, 10, 28, 0.75);
  --border-glow: rgba(168,85,247,0.12);
  --border-subtle: rgba(255,255,255,0.04);
  --border-medium: rgba(255,255,255,0.08);
}

@layer base {
  * {
    @apply border-border;
    -webkit-tap-highlight-color: transparent;
  }

  *,
  *::before,
  *::after {
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  a, button, select,
  [role="button"], [tabindex]:not([tabindex="-1"]),
  [type="checkbox"], [type="radio"],
  summary {
    @apply focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none;
    will-change: transform;
  }

  input, textarea {
    @apply focus-visible:outline-none;
  }

  html, body, #root {
    height: 100%;
    height: 100dvh;
    overflow: hidden;
  }

  html {
    background-color: hsl(250 15% 4%);
    scroll-behavior: smooth;
  }

  html::before {
    content: '';
    position: fixed;
    inset: 0;
    z-index: -1;
    opacity: 1;
    pointer-events: none;
    background-image:
      radial-gradient(ellipse 80% 60% at 15% 85%, var(--aurora-1) 0%, transparent 60%),
      radial-gradient(ellipse 70% 50% at 85% 15%, var(--aurora-2) 0%, transparent 55%),
      radial-gradient(ellipse 60% 40% at 50% 50%, var(--aurora-4) 0%, transparent 50%),
      radial-gradient(ellipse 50% 30% at 70% 70%, var(--aurora-3) 0%, transparent 45%);
    animation: aurora-drift 60s ease-in-out infinite alternate;
  }

  body {
    @apply text-foreground antialiased;
    font-family: var(--font-sans-family);
    -webkit-text-size-adjust: 100%;
    position: fixed;
    width: 100%;
    height: 100%;
    background: transparent;
    text-rendering: optimizeLegibility;
    touch-action: manipulation;
  }

  h1 {
    font-family: var(--font-display);
    @apply font-bold tracking-tight text-2xl;
  }
  h2 {
    font-family: var(--font-display);
    @apply font-bold tracking-tight text-xl;
  }
  h3 {
    font-family: var(--font-display);
    @apply font-semibold tracking-tight text-lg;
  }
  h4, h5, h6 {
    font-family: var(--font-display);
    @apply font-semibold tracking-tight text-base;
  }
}

@layer components {
  .glass-panel {
    background: var(--surface-glass);
    backdrop-filter: blur(24px) saturate(160%);
    -webkit-backdrop-filter: blur(24px) saturate(160%);
    border: 1px solid var(--border-medium);
    border-radius: 0.75rem;
    box-shadow:
      0 0 0 1px rgba(255,255,255,0.02),
      0 8px 32px rgba(0,0,0,0.35),
      0 2px 8px rgba(0,0,0,0.2),
      inset 0 1px 0 rgba(255,255,255,0.05);
    transform: translateZ(0);
    transition: opacity 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .glass-panel:hover {
    border-color: var(--border-glow);
    box-shadow:
      0 0 0 1px rgba(168,85,247,0.06),
      0 12px 40px rgba(0,0,0,0.4),
      0 4px 12px rgba(0,0,0,0.25),
      inset 0 1px 0 rgba(255,255,255,0.06),
      0 0 30px rgba(168,85,247,0.04);
  }

  .glass-card {
    background: var(--surface-glass);
    backdrop-filter: blur(20px) saturate(160%);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    border: 1px solid var(--border-subtle);
    border-radius: 0.75rem;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
  }

  .glass-card:hover {
    border-color: hsl(var(--primary) / 0.18);
    box-shadow:
      0 8px 32px rgba(0,0,0,0.3),
      0 0 20px hsl(var(--primary) / 0.06),
      inset 0 1px 0 rgba(255,255,255,0.06);
    transform: translateY(-1px);
  }

  .tessera-page {
    background: rgba(4, 2, 10, 0.88) !important;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    transform: translateZ(0);
    box-shadow: inset 0 1px 0 rgba(168,85,247,0.04);
  }

  .tessera-card {
    background: var(--surface-elevated) !important;
    backdrop-filter: blur(20px) saturate(150%);
    -webkit-backdrop-filter: blur(20px) saturate(150%);
    border: 1px solid var(--border-medium);
    border-radius: 0.75rem;
    transform: translateZ(0);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
  }

  .tessera-card:hover {
    border-color: var(--border-glow);
    box-shadow:
      0 8px 24px rgba(0,0,0,0.3),
      0 0 20px rgba(168,85,247,0.06);
    transform: translateZ(0) translateY(-1px);
  }

  .sovereign-gradient {
    background: linear-gradient(135deg, hsl(var(--primary) / 0.08), transparent, hsl(var(--chart-2) / 0.06));
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    display: inline-block;
  }

  .status-online {
    background: #4ade80;
    box-shadow: 0 0 6px rgba(74,222,128,0.5);
    animation: pulse 2s ease-in-out infinite;
  }

  .status-offline {
    background: #6b7280;
  }
}

@layer utilities {
  .custom-scrollbar::-webkit-scrollbar {
    width: 4px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: rgba(139,92,246,0.15);
    border-radius: 4px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: rgba(139,92,246,0.3);
  }

  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-none {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  input[type="search"]::-webkit-search-cancel-button {
    @apply hidden;
  }
}

@keyframes aurora-drift {
  0% { opacity: 0.7; filter: hue-rotate(0deg); }
  50% { opacity: 1; filter: hue-rotate(15deg); }
  100% { opacity: 0.7; filter: hue-rotate(-10deg); }
}

@keyframes sacred-shift {
  0% { transform: translateX(0) translateY(0); }
  100% { transform: translateX(80px) translateY(140px); }
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

@keyframes glow-pulse {
  0%, 100% { box-shadow: 0 0 8px rgba(139,92,246,0.3); }
  50% { box-shadow: 0 0 16px rgba(139,92,246,0.5); }
}
