<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
<meta http-equiv="Content-Security-Policy" content="default-src 'self' 'unsafe-inline' data: blob:; connect-src 'self' https:; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' blob:; script-src 'self' 'unsafe-inline' blob:; style-src 'self' 'unsafe-inline'; frame-src 'none'; object-src 'none'; base-uri 'self';">
<meta name="robots" content="noindex,nofollow,noarchive,nosnippet,noimageindex">
<meta name="googlebot" content="noindex,nofollow,noarchive,nosnippet,noimageindex">
<meta http-equiv="X-Robots-Tag" content="noindex,nofollow,noarchive">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Tesseract">
<meta name="mobile-web-app-capable" content="yes">
<meta name="theme-color" content="#0a0a0f">
<meta name="description" content="">
<meta name="referrer" content="no-referrer">
<meta http-equiv="Cache-Control" content="no-store,no-cache,must-revalidate,private">
<meta http-equiv="Pragma" content="no-cache">
<link rel="apple-touch-icon" href="data:image/svg+xml;base64,">
<title>Tesseract</title>
<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{--bg:#08080d;--s1:#0f0f18;--s2:#171725;--s3:#1f1f33;--bd:#252540;--tx:#e2e2ec;--dm:#7878a0;--cy:#06b6d4;--vi:#7c3aed;--am:#f59e0b;--gn:#22c55e;--rd:#ef4444;--pk:#ec4899;--bl:#3b82f6;--r:14px}
body{background:var(--bg);color:var(--tx);font-family:-apple-system,BlinkMacSystemFont,'SF Pro Display',system-ui,sans-serif;min-height:100vh;min-height:100dvh;overflow-x:hidden;-webkit-tap-highlight-color:transparent;-webkit-touch-callout:none;-webkit-user-select:none;user-select:none;overscroll-behavior:none}
button,input,textarea{-webkit-tap-highlight-color:transparent;-webkit-appearance:none;appearance:none;touch-action:manipulation;font-family:inherit}

.splash{position:fixed;inset:0;background:var(--bg);display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:99999;transition:opacity .5s}
.splash.out{opacity:0;pointer-events:none}
.s-diamond{width:80px;height:80px;position:relative;margin-bottom:20px}
.s-diamond svg{width:100%;height:100%;filter:drop-shadow(0 0 20px rgba(124,58,237,.5))}
.s-title{font-size:20px;font-weight:800;background:linear-gradient(135deg,var(--vi),var(--cy));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;letter-spacing:4px}
.s-sub{margin-top:6px;font-size:10px;color:var(--dm);letter-spacing:5px;font-family:monospace}
.s-bar{width:180px;height:2px;background:var(--s2);border-radius:1px;margin-top:24px;overflow:hidden}
.s-fill{height:100%;width:0;background:linear-gradient(90deg,var(--vi),var(--cy));border-radius:1px;transition:width .2s}
.s-status{margin-top:10px;font-size:9px;color:var(--dm);font-family:monospace;letter-spacing:1px;min-height:14px}

.gate{min-height:100vh;min-height:100dvh;display:none;align-items:center;justify-content:center;padding:20px;background:var(--bg)}
.g-box{max-width:360px;width:100%;text-align:center}
.g-icon{width:64px;height:64px;margin:0 auto 20px}
.g-icon svg{width:100%;height:100%;filter:drop-shadow(0 0 16px rgba(124,58,237,.4))}
.g-title{font-size:12px;font-weight:700;color:var(--vi);letter-spacing:4px;font-family:monospace}
.g-proto{font-size:9px;color:var(--dm);margin:6px 0 20px;font-family:monospace;letter-spacing:2px}
.g-input{width:100%;padding:16px;border-radius:var(--r);border:2px solid var(--bd);background:var(--s1);color:var(--tx);font-size:18px;font-family:monospace;text-align:center;outline:none;transition:all .3s;letter-spacing:4px;-webkit-user-select:text;user-select:text}
.g-input:focus{border-color:var(--vi);box-shadow:0 0 24px rgba(124,58,237,.15)}
.g-err{font-size:10px;color:var(--rd);margin-top:8px;display:none;font-family:monospace}
.g-hint{font-size:9px;color:var(--dm);margin-top:14px;font-family:monospace}
.g-sec{margin-top:24px;font-size:8px;color:var(--s3);font-family:monospace;letter-spacing:2px}

.app{max-width:480px;margin:0 auto;padding:env(safe-area-inset-top,10px) 10px calc(16px + env(safe-area-inset-bottom,0px));display:none}
.hd{padding:12px 4px;display:flex;align-items:center;justify-content:space-between}
.hd-left{display:flex;align-items:center;gap:10px}
.hd-logo{width:32px;height:32px}
.hd-logo svg{width:100%;height:100%;filter:drop-shadow(0 0 8px rgba(124,58,237,.3))}
.hd-text .logo{font-size:18px;font-weight:800;background:linear-gradient(135deg,var(--vi),var(--cy));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;letter-spacing:1px}
.hd-text .ver{font-size:8px;color:var(--dm);font-family:monospace;letter-spacing:2px;margin-top:1px}
.hd-right{display:flex;align-items:center;gap:8px}
.hd-ping{font-size:9px;font-family:monospace;color:var(--gn)}
.hd-ping.off{color:var(--rd)}
.ld{width:6px;height:6px;border-radius:50%;display:inline-block;vertical-align:middle;margin-right:3px}
.ld.on{background:var(--gn);box-shadow:0 0 6px var(--gn);animation:bk 2s infinite}
.ld.off{background:var(--rd);box-shadow:0 0 6px var(--rd)}
@keyframes bk{0%,100%{opacity:1}50%{opacity:.35}}

.conn{display:flex;align-items:center;gap:6px;padding:7px 10px;background:var(--s1);border:1px solid var(--bd);border-radius:10px;margin:6px 0;font-size:9px;font-family:monospace}
.conn.live{border-color:rgba(34,197,94,.3)}.conn.vault{border-color:rgba(245,158,11,.3)}
.conn .proto{color:var(--vi);font-weight:700}.conn .addr{color:var(--cy);flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.conn .sync-t{color:var(--dm)}

.tabs{display:flex;gap:3px;padding:6px 0;overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none}
.tabs::-webkit-scrollbar{display:none}
.tab{padding:8px 12px;border-radius:10px;border:1px solid transparent;background:transparent;color:var(--dm);font-size:10px;font-weight:600;white-space:nowrap;cursor:pointer;transition:all .2s;flex-shrink:0}
.tab:active{transform:scale(.95)}
.tab.on{background:linear-gradient(135deg,rgba(124,58,237,.15),rgba(6,182,212,.1));color:var(--vi);border-color:rgba(124,58,237,.25)}

.pn{display:none}.pn.on{display:block}
.sec{font-size:12px;font-weight:700;color:var(--vi);margin:14px 0 6px;padding-bottom:5px;border-bottom:1px solid var(--bd);display:flex;align-items:center;gap:6px}
.cd{background:var(--s1);border:1px solid var(--bd);border-radius:var(--r);padding:12px;margin:6px 0;transition:border-color .3s}
.cd.gv{border-color:rgba(124,58,237,.25)}.cd.gc{border-color:rgba(6,182,212,.25)}.cd.gg{border-color:rgba(34,197,94,.25)}.cd.ga{border-color:rgba(245,158,11,.25)}.cd.gr{border-color:rgba(239,68,68,.25)}
.ct{font-size:12px;font-weight:700;margin-bottom:4px;display:flex;align-items:center;gap:5px}
.inf{font-size:10px;color:var(--dm);line-height:1.6;margin:3px 0}.inf b{color:var(--tx)}
.bg{display:inline-block;padding:2px 7px;border-radius:5px;font-size:8px;font-weight:700;text-transform:uppercase;letter-spacing:.5px}
.bv{background:rgba(124,58,237,.15);color:var(--vi)}.bc{background:rgba(6,182,212,.15);color:var(--cy)}.bgn{background:rgba(34,197,94,.15);color:var(--gn)}.ba{background:rgba(245,158,11,.15);color:var(--am)}.br{background:rgba(239,68,68,.15);color:var(--rd)}.bp{background:rgba(236,72,153,.15);color:var(--pk)}

.g2{display:grid;grid-template-columns:1fr 1fr;gap:6px}.g3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:5px}
.st{background:var(--s2);border-radius:10px;padding:9px;text-align:center}
.sv{font-size:18px;font-weight:800;background:linear-gradient(135deg,var(--vi),var(--cy));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.sl{font-size:8px;color:var(--dm);margin-top:2px;text-transform:uppercase;letter-spacing:.5px}
.bar{width:100%;height:5px;background:var(--s2);border-radius:3px;overflow:hidden;margin:3px 0}
.bf{height:100%;border-radius:3px;transition:width .5s}

.btn{width:100%;padding:13px;border-radius:var(--r);border:none;font-weight:700;font-size:12px;cursor:pointer;transition:all .15s;margin:4px 0;color:#fff;letter-spacing:.5px}
.btn:active{transform:scale(.96);opacity:.85}
.btn-v{background:linear-gradient(135deg,var(--vi),var(--cy))}.btn-a{background:linear-gradient(135deg,var(--am),#d97706);color:#000}.btn-g{background:linear-gradient(135deg,var(--gn),#16a34a)}.btn-r{background:linear-gradient(135deg,var(--rd),#b91c1c)}

.rw{display:flex;align-items:center;gap:7px;padding:9px;background:var(--s2);border-radius:9px;margin:3px 0}
.dt{width:7px;height:7px;border-radius:50%;flex-shrink:0}
.rn{font-size:10px;font-weight:600;flex:1}.rs{font-size:8px;color:var(--gn);font-weight:600}

.rit{padding:11px;border-radius:10px;margin:5px 0;border-left:3px solid;background:var(--s1)}
.rit .rh{display:flex;align-items:center;gap:5px;margin-bottom:3px}
.rit .rd2{width:7px;height:7px;border-radius:50%;animation:bk 1.5s infinite}
.rit .rt{font-size:11px;font-weight:700}.rit .ri{font-size:9px;color:var(--dm);line-height:1.5}.rit .rok{font-size:9px;color:var(--gn);font-weight:600;margin-top:3px}

.dg{display:grid;grid-template-columns:repeat(4,1fr);gap:3px;margin:6px 0}
.ds{height:26px;border-radius:5px;display:flex;align-items:center;justify-content:center;font-size:7px;font-weight:700}
.ds.active{background:var(--gn);color:#000}.ds.activating{background:var(--am);color:#000;animation:bk 1.5s infinite}.ds.dormant{background:var(--s2);color:var(--dm)}

.thr{display:flex;align-items:center;gap:5px;padding:6px 7px;background:var(--s2);border-radius:5px;margin:2px 0;font-size:9px}
.thr .tn{color:var(--dm);flex:1}.thr .tb{width:45px;height:3px;background:#222;border-radius:2px;overflow:hidden}.thr .tf{height:100%;border-radius:2px}

.frq{display:flex;align-items:center;gap:5px;padding:5px 7px;font-size:9px;color:var(--cy);cursor:pointer}
.frq:active{opacity:.7}

.mi{display:flex;gap:5px;margin:6px 0}
.mi-in{flex:1;padding:11px;border-radius:10px;border:1px solid var(--bd);background:var(--s1);color:var(--tx);font-size:11px;outline:none;-webkit-user-select:text;user-select:text}
.mi-in:focus{border-color:var(--cy)}
.mi-btn{padding:11px 14px;border-radius:10px;border:none;background:var(--vi);color:#fff;font-weight:700;font-size:11px;cursor:pointer}

.msg{padding:7px 9px;background:var(--s2);border-radius:7px;margin:3px 0;border-left:2px solid var(--cy)}
.mf{font-size:8px;font-weight:700;color:var(--cy)}.mt{font-size:9px;color:var(--dm);margin-top:2px;line-height:1.4}.ms{font-size:7px;color:var(--dm);opacity:.6;margin-top:2px}

.prt{padding:9px;margin:3px 0;border-left:3px solid;background:var(--s2);border-radius:7px}
.dr{display:flex;align-items:center;gap:7px;margin:3px 0}.dr .lb{font-size:10px;flex:1}.dr .pc{font-size:12px;font-weight:800;min-width:36px;text-align:right}

.cv{padding:10px;background:linear-gradient(135deg,rgba(124,58,237,.06),rgba(6,182,212,.06));border:1px solid rgba(124,58,237,.15);border-radius:10px;margin:6px 0}
.cv h4{font-size:11px;font-weight:700;color:var(--am);margin-bottom:4px}.cv p{font-size:9px;color:var(--dm);line-height:1.5}

.tl-entry{padding:7px 9px;background:var(--s2);border-radius:7px;margin:3px 0;border-left:2px solid var(--vi);font-size:9px}
.tl-entry .tl-t{color:var(--dm);font-size:7px;margin-bottom:2px}.tl-entry .tl-m{color:var(--tx)}

.toast{position:fixed;bottom:calc(16px + env(safe-area-inset-bottom,0px));left:50%;transform:translateX(-50%);background:var(--s1);border:1px solid var(--vi);border-radius:10px;padding:10px 18px;font-size:11px;font-weight:600;z-index:99999;opacity:0;transition:opacity .3s;pointer-events:none;max-width:85%;text-align:center;box-shadow:0 4px 24px rgba(0,0,0,.6)}
.toast.show{opacity:1}

.pwa-ban{position:fixed;bottom:0;left:0;right:0;background:var(--s1);border-top:1px solid var(--vi);padding:12px 14px;display:none;align-items:center;gap:8px;z-index:10000;padding-bottom:calc(12px + env(safe-area-inset-bottom,0px))}
.pwa-ban .pt{flex:1;font-size:10px;color:var(--tx)}.pwa-ban .pt b{color:var(--vi)}
.pwa-ban .pb2{padding:7px 14px;border-radius:7px;border:none;background:var(--vi);color:#fff;font-weight:700;font-size:10px;cursor:pointer}
.pwa-ban .px{padding:3px 7px;border:none;background:none;color:var(--dm);font-size:14px;cursor:pointer}

.cp{position:fixed;inset:0;background:var(--bg);z-index:10001;display:none;flex-direction:column}
.cp.on{display:flex}
.cp-h{padding:12px 14px;border-bottom:1px solid var(--bd);display:flex;align-items:center;gap:8px;padding-top:calc(12px + env(safe-area-inset-top,0px))}
.cp-bk{padding:5px 9px;border:none;background:var(--s2);color:var(--tx);border-radius:7px;font-size:11px;font-weight:700;cursor:pointer}
.cp-msgs{flex:1;overflow-y:auto;padding:10px 14px;-webkit-overflow-scrolling:touch}
.cp-m{max-width:82%;padding:9px 12px;border-radius:12px;margin:3px 0;font-size:11px;line-height:1.5;word-break:break-word}
.cp-m.u{background:var(--vi);color:#fff;margin-left:auto;border-bottom-right-radius:3px}
.cp-m.a{background:var(--s2);color:var(--tx);border-bottom-left-radius:3px}
.cp-m.a .an2{font-size:8px;font-weight:700;color:var(--cy);margin-bottom:3px}
.cp-typ{padding:9px 12px;background:var(--s2);border-radius:12px;margin:3px 0;max-width:55%;display:none;font-size:11px;color:var(--dm)}
.cp-typ.on{display:block}
.cp-ft{padding:10px 14px;border-top:1px solid var(--bd);display:flex;gap:7px;padding-bottom:calc(10px + env(safe-area-inset-bottom,0px))}
.cp-in{flex:1;padding:11px;border-radius:10px;border:1px solid var(--bd);background:var(--s1);color:var(--tx);font-size:12px;outline:none;-webkit-user-select:text;user-select:text;resize:none}
.cp-in:focus{border-color:var(--vi)}
.cp-snd{padding:11px 16px;border-radius:10px;border:none;background:linear-gradient(135deg,var(--vi),var(--cy));color:#fff;font-weight:700;font-size:12px;cursor:pointer}
</style>
</head>
<body>

<div class="splash" id="splash">
  <div class="s-diamond"><svg viewBox="0 0 80 80"><path d="M40 8L72 40L40 72L8 40Z" fill="none" stroke="#7c3aed" stroke-width="2.5" opacity=".6"><animate attributeName="opacity" values=".6;1;.6" dur="2s" repeatCount="indefinite"/></path><path d="M40 20L60 40L40 60L20 40Z" fill="#7c3aed" fill-opacity=".25" stroke="#7c3aed" stroke-width="1.5"/><circle cx="40" cy="40" r="3" fill="#06b6d4"><animate attributeName="r" values="3;5;3" dur="2s" repeatCount="indefinite"/></circle></svg></div>
  <div class="s-title">TESSERACT</div>
  <div class="s-sub">SOVEREIGN MESH</div>
  <div class="s-bar"><div class="s-fill" id="sFill"></div></div>
  <div class="s-status" id="sStatus"></div>
</div>

<div class="gate" id="gate">
  <div class="g-box">
    <div class="g-icon"><svg viewBox="0 0 64 64"><path d="M32 6L58 32L32 58L6 32Z" fill="none" stroke="#7c3aed" stroke-width="2"/><path d="M32 18L46 32L32 46L18 32Z" fill="#7c3aed" fill-opacity=".2" stroke="#7c3aed" stroke-width="1.5"/><circle cx="32" cy="32" r="2.5" fill="#06b6d4"/></svg></div>
    <div class="g-title">TESSERACT SOVEREIGN</div>
    <div class="g-proto">TESS://ENCRYPTED.MESH</div>
    <input type="password" class="g-input" id="gK" placeholder="&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;&#x2022;" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" inputmode="text" data-testid="input-gate">
    <div class="g-err" id="gE">ACCESS DENIED</div>
    <div class="g-hint">Enter sovereign key</div>
    <div class="g-sec">COLONEL v3 ENCRYPTED | ZERO TRACE | SOVEREIGN</div>
  </div>
</div>

<div class="app" id="app">
  <div class="hd">
    <div class="hd-left">
      <div class="hd-logo"><svg viewBox="0 0 32 32"><path d="M16 3L29 16L16 29L3 16Z" fill="none" stroke="#7c3aed" stroke-width="1.5"/><path d="M16 9L23 16L16 23L9 16Z" fill="#7c3aed" fill-opacity=".2" stroke="#7c3aed" stroke-width="1"/><circle cx="16" cy="16" r="1.5" fill="#06b6d4"/></svg></div>
      <div class="hd-text"><div class="logo">TESSERACT</div><div class="ver">TESS:// v9.0 SOVEREIGN</div></div>
    </div>
    <div class="hd-right">
      <span class="hd-ping" id="hPing"><span class="ld on" id="hDot"></span><span id="hMs">--</span></span>
    </div>
  </div>

  <div class="conn" id="cBar">
    <span class="proto">TESS://</span>
    <span class="addr" id="cAddr">sovereign.mesh/home</span>
    <span class="sync-t" id="cSync">--</span>
    <span class="bg ba" id="cBg">INIT</span>
  </div>

  <div class="tabs" id="tBar"></div>

  <div id="pH" class="pn on"></div>
  <div id="pC" class="pn"></div>
  <div id="pS" class="pn"></div>
  <div id="pHl" class="pn"></div>
  <div id="pR" class="pn"></div>
  <div id="pCn" class="pn"></div>
  <div id="pA" class="pn"></div>
  <div id="pE" class="pn"></div>
  <div id="pSh" class="pn"></div>
  <div id="pN" class="pn"></div>
  <div id="pTl" class="pn"></div>
</div>

<div class="toast" id="toast"></div>

<div class="pwa-ban" id="pwaB">
  <div class="pt"><b>Save Tesseract</b> to home screen</div>
  <button class="pb2" id="pwaI" data-testid="button-pwa">Install</button>
  <button class="px" id="pwaX">&#x2715;</button>
</div>

<div class="cp" id="chatP">
  <div class="cp-h">
    <button class="cp-bk" id="cpBk" data-testid="button-chat-back">&#x2190;</button>
    <div style="flex:1;text-align:center"><div style="font-size:12px;font-weight:700">Tesseract Swarm</div><div style="font-size:8px;color:var(--dm);font-family:monospace">TESS://chat.mesh | 26 agents</div></div>
    <span class="ld on"></span>
  </div>
  <div class="cp-msgs" id="cpMs"></div>
  <div class="cp-typ" id="cpTy">Tessera-Prime is thinking...</div>
  <div class="cp-ft">
    <input class="cp-in" id="cpIn" placeholder="Talk to the swarm..." autocomplete="off" spellcheck="false" data-testid="input-chat">
    <button class="cp-snd" id="cpSn" data-testid="button-send">Send</button>
  </div>
</div>

<script>
(function(){
"use strict";

var HASH='8d2da0d4c9a6b6d9a6ace7332265b1a3a4f4fd44';
var DB='TesseractVault_v9';var DBV=7;var db=null;
var apiBase='';var token='';var conn=false;var curTab='home';
var meshId='';var lastPing=0;var lastSync=0;var failAttempts=0;
var chatH=[];var nexusM=[];var timeline=[];
var live={status:null,rituals:null,dna:null,moon:null,conf:null,swarm:null};
var audioCtx=null;

function crand(n){var a=new Uint8Array(n);crypto.getRandomValues(a);return Array.from(a,function(b){return b.toString(16).padStart(2,'0')}).join('')}
meshId='TSR-'+crand(4).toUpperCase();

function sha1(s){var i,j,W=[],H=[0x67452301,0xEFCDAB89,0x98BADCFE,0x10325476,0xC3D2E1F0];var msg=[];for(i=0;i<s.length;i++){var c=s.charCodeAt(i);if(c<128)msg.push(c);else if(c<2048){msg.push(192|(c>>6));msg.push(128|(c&63))}else{msg.push(224|(c>>12));msg.push(128|((c>>6)&63));msg.push(128|(c&63))}}var ml=msg.length*8;msg.push(0x80);while(msg.length%64!==56)msg.push(0);msg.push(0,0,0,0);msg.push((ml>>>24)&0xff,(ml>>>16)&0xff,(ml>>>8)&0xff,ml&0xff);for(i=0;i<msg.length;i+=64){for(j=0;j<16;j++)W[j]=(msg[i+j*4]<<24)|(msg[i+j*4+1]<<16)|(msg[i+j*4+2]<<8)|msg[i+j*4+3];for(j=16;j<80;j++){var x=W[j-3]^W[j-8]^W[j-14]^W[j-16];W[j]=(x<<1)|(x>>>31)}var a=H[0],b=H[1],c2=H[2],d=H[3],e=H[4];for(j=0;j<80;j++){var f2,k;if(j<20){f2=(b&c2)|((~b)&d);k=0x5A827999}else if(j<40){f2=b^c2^d;k=0x6ED9EBA1}else if(j<60){f2=(b&c2)|(b&d)|(c2&d);k=0x8F1BBCDC}else{f2=b^c2^d;k=0xCA62C1D6}var t=((a<<5)|(a>>>27))+f2+e+k+W[j];e=d;d=c2;c2=(b<<30)|(b>>>2);b=a;a=t>>>0}H[0]=(H[0]+a)>>>0;H[1]=(H[1]+b)>>>0;H[2]=(H[2]+c2)>>>0;H[3]=(H[3]+d)>>>0;H[4]=(H[4]+e)>>>0}var hex='';for(i=0;i<5;i++)hex+=('00000000'+H[i].toString(16)).slice(-8);return hex}

function deriveKey(t){return sha1(t+'-'+Math.floor(Date.now()/300000)).substr(0,32)}
function xorEnc(data,key){var k=key||deriveKey(token);var out='';for(var i=0;i<data.length;i++){out+=String.fromCharCode(data.charCodeAt(i)^k.charCodeAt(i%k.length))}return btoa(out)}
function xorDec(enc,key){var k=key||deriveKey(token);try{var raw=atob(enc);var out='';for(var i=0;i<raw.length;i++){out+=String.fromCharCode(raw.charCodeAt(i)^k.charCodeAt(i%k.length))}return out}catch(e){return null}}

navigator.sendBeacon=function(){return false};
if(window.PerformanceObserver){try{new PerformanceObserver(function(){}).disconnect()}catch(e){}}

function scrambleFingerprint(){try{var c=document.createElement('canvas');var ctx=c.getContext('2d');if(ctx){ctx.fillStyle='#'+crand(3);ctx.fillRect(0,0,1,1)}}catch(e){}}
scrambleFingerprint();

var $(function(id){return document.getElementById(id)});function $$(id){return document.getElementById(id)}
function esc(s){return s==null?'':String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')}
function h(el,html){var e=typeof el==='string'?$$(el):el;if(e)e.innerHTML=html}
function toast(m){var t=$$('toast');t.textContent=m;t.classList.add('show');setTimeout(function(){t.classList.remove('show')},3000)}
function tlog(m){var e={id:Date.now(),ts:Date.now(),msg:m};timeline.unshift(e);if(timeline.length>200)timeline=timeline.slice(0,200);dbp('timeline',e).catch(function(){})}
function vibrate(ms){try{navigator.vibrate&&navigator.vibrate(ms||10)}catch(e){}}

var TABS=[
{id:'home',l:'Home',p:'pH'},{id:'chat',l:'Chat',p:null},{id:'swarm',l:'Swarm',p:'pS'},
{id:'healing',l:'Healing',p:'pHl'},{id:'rituals',l:'Rituals',p:'pR'},{id:'council',l:'Council',p:'pCn'},
{id:'aware',l:'Awareness',p:'pA'},{id:'economy',l:'Economy',p:'pE'},{id:'shield',l:'Shield',p:'pSh'},
{id:'nexus',l:'Nexus',p:'pN'},{id:'log',l:'Log',p:'pTl'}
];

var tabBar=$$('tBar');
TABS.forEach(function(t){
  var b=document.createElement('button');
  b.className='tab'+(t.id==='home'?' on':'');
  b.textContent=t.l;b.dataset.t=t.id;
  b.setAttribute('data-testid','tab-'+t.id);
  b.addEventListener('click',function(){
    if(t.id==='chat'){$$('chatP').classList.add('on');renderChat();return}
    vibrate();
    document.querySelectorAll('.tab').forEach(function(x){x.classList.remove('on')});b.classList.add('on');
    curTab=t.id;
    document.querySelectorAll('.pn').forEach(function(p){p.classList.remove('on')});
    if(t.p){var pn=$$(t.p);if(pn)pn.classList.add('on')}
    $$('cAddr').textContent='sovereign.mesh/'+t.id;
    render(t.id);window.scrollTo(0,0);
  });
  tabBar.appendChild(b);
});

var touchStartX=0;
document.addEventListener('touchstart',function(e){touchStartX=e.touches[0].clientX},{passive:true});
document.addEventListener('touchend',function(e){
  if($$('chatP').classList.contains('on'))return;
  var dx=e.changedTouches[0].clientX-touchStartX;
  if(Math.abs(dx)<60)return;
  var curIdx=TABS.findIndex(function(t){return t.id===curTab});
  if(dx<0&&curIdx<TABS.length-1){var next=TABS[curIdx+1];if(next.id==='chat'){if(curIdx+2<TABS.length)next=TABS[curIdx+2];else return}document.querySelector('[data-t="'+next.id+'"]').click()}
  if(dx>0&&curIdx>0){var prev=TABS[curIdx-1];if(prev.id==='chat'){if(curIdx-2>=0)prev=TABS[curIdx-2];else return}document.querySelector('[data-t="'+prev.id+'"]').click()}
},{passive:true});

var sSteps=['Initializing sovereign kernel...','Loading Colonel cipher v3...','Scrambling fingerprints...','Mounting encrypted vault...','Establishing TESS:// protocol...','Activating 26-agent swarm...','Bridging mesh network...','Sovereign lattice ready'];
var sIdx=0;var sFill=$$('sFill');var sStatus=$$('sStatus');
var sInt=setInterval(function(){
  sIdx++;var pct=Math.min(100,sIdx*14);sFill.style.width=pct+'%';
  if(sIdx<=sSteps.length)sStatus.textContent=sSteps[Math.min(sIdx-1,sSteps.length-1)];
  if(pct>=100){clearInterval(sInt);setTimeout(function(){$$('splash').classList.add('out');$$('gate').style.display='flex';setTimeout(function(){try{$$('splash').remove()}catch(e){}},500)},300)}
},280);

function checkGate(){
  var input=$$('gK');var val=input.value;
  if(sha1(val)===HASH){
    token=val;failAttempts=0;
    $$('gate').style.display='none';$$('app').style.display='block';
    apiBase=location.protocol+'//'+location.host;
    odb().then(function(){
      return Promise.all([dbg('chatHistory'),dbg('messages'),dbg('timeline')]);
    }).then(function(r){
      if(r[0]&&r[0].length)chatH=r[0].sort(function(a,b){return a.ts-b.ts}).slice(-100);
      if(r[1]&&r[1].length)nexusM=r[1].sort(function(a,b){return a.ts-b.ts}).slice(-50);
      if(r[2]&&r[2].length)timeline=r[2].sort(function(a,b){return b.ts-a.ts}).slice(0,200);
    }).catch(function(){});
    fetchAll();setInterval(fetchAll,30000);
    setInterval(pingMesh,15000);pingMesh();
    render('home');
    tlog('Sovereign lattice unlocked');toast('TESS:// Sovereign \u2014 All systems live');
    if(!window.navigator.standalone&&!window.matchMedia('(display-mode:standalone)').matches){
      setTimeout(function(){$$('pwaB').style.display='flex'},2000);
    }
  } else if(val.length>=4){
    failAttempts++;
    $$('gE').style.display='block';input.value='';
    setTimeout(function(){$$('gE').style.display='none'},2000);
    if(failAttempts>=5){
      clearAllData();
      document.body.innerHTML='<div style="height:100vh;display:flex;align-items:center;justify-content:center;color:#333;font-size:12px">Page not found</div>';
      tlog('Dead man switch triggered — all data wiped');
    }
  }
}
$$('gK').addEventListener('input',checkGate);
$$('gK').addEventListener('keydown',function(e){if(e.key==='Enter')checkGate()});

function clearAllData(){try{indexedDB.deleteDatabase(DB);localStorage.clear();sessionStorage.clear()}catch(e){}}

function pingMesh(){
  if(!apiBase)return;
  var t0=performance.now();
  var xhr=new XMLHttpRequest();
  xhr.open('GET',apiBase+'/api/swarm/status',true);
  xhr.setRequestHeader('x-admin-token',token);
  xhr.timeout=6000;
  xhr.onload=function(){
    if(xhr.status>=200&&xhr.status<300){
      var ms=Math.round(performance.now()-t0);
      lastPing=ms;setLive(ms);
    } else {setVault()}
  };
  xhr.onerror=function(){setVault()};
  xhr.ontimeout=function(){setVault()};
  xhr.send();
}

function setLive(ms){
  if(!conn)tlog('Mesh connected \u2014 '+ms+'ms');
  conn=true;
  $$('hDot').className='ld on';$$('hMs').textContent=ms+'ms';$$('hPing').className='hd-ping';
  $$('cBg').textContent='LIVE';$$('cBg').className='bg bgn';$$('cBar').className='conn live';
  $$('cSync').textContent='Sync: '+new Date().toLocaleTimeString();lastSync=Date.now();
}
function setVault(){
  if(conn)tlog('Mesh disconnected \u2014 vault mode');
  conn=false;
  $$('hDot').className='ld off';$$('hMs').textContent='--';$$('hPing').className='hd-ping off';
  $$('cBg').textContent='VAULT';$$('cBg').className='bg ba';$$('cBar').className='conn vault';
}

function apiFetch(path,cb,method,body){
  if(!apiBase)return;
  var xhr=new XMLHttpRequest();
  xhr.open(method||'GET',apiBase+path,true);
  xhr.setRequestHeader('x-admin-token',token);
  if(body)xhr.setRequestHeader('Content-Type','application/json');
  xhr.timeout=10000;
  xhr.onload=function(){if(xhr.status>=200&&xhr.status<300){try{var d=JSON.parse(xhr.responseText);cb(d);var enc=xorEnc(xhr.responseText);dbp('cache',{key:path,data:enc,ts:Date.now()}).catch(function(){})}catch(e){}}};
  xhr.onerror=function(){loadCached(path,cb)};
  xhr.ontimeout=function(){loadCached(path,cb)};
  xhr.send(body?JSON.stringify(body):null);
}
function loadCached(path,cb){
  dbGet('cache',path).then(function(r){
    if(r&&r.data){var dec=xorDec(r.data);if(dec){try{cb(JSON.parse(dec))}catch(e){}}}
  }).catch(function(){});
}

function fetchAll(){
  apiFetch('/api/sovereign/status',function(d){live.status=d;if(curTab==='home')render('home')});
  apiFetch('/api/active-rituals',function(d){live.rituals=d;if(curTab==='rituals')render('rituals')});
  apiFetch('/api/dna-healing/status',function(d){live.dna=d;if(curTab==='healing')render('healing')});
  apiFetch('/api/moon-cycle/current',function(d){live.moon=d});
  apiFetch('/api/grand-unified-conference',function(d){live.conf=d;if(curTab==='council')render('council')});
  apiFetch('/api/swarm/status',function(d){live.swarm=d;if(curTab==='swarm')render('swarm')});
  apiFetch('/api/xmr/tumbler/status',function(d){live.xmr=d;if(curTab==='home')render('home')});
  apiFetch('/api/grand-comprehensive-conference',function(d){live.compConf=d;if(curTab==='council')render('council')});
  apiFetch('/api/grand-conference-of-conferences',function(d){live.grandConf=d;if(curTab==='council')render('council')});
}

function odb(){return new Promise(function(ok,no){if(db)return ok(db);var r=indexedDB.open(DB,DBV);r.onupgradeneeded=function(){var d=r.result;['chatHistory','messages','timeline','cache','data'].forEach(function(s){if(!d.objectStoreNames.contains(s))d.createObjectStore(s,{keyPath:s==='cache'||s==='data'?'key':'id',autoIncrement:s!=='cache'&&s!=='data'})})};r.onsuccess=function(){db=r.result;ok(db)};r.onerror=function(){no(r.error)}})}
function dbp(s,d){return odb().then(function(x){return new Promise(function(ok,no){var t=x.transaction(s,'readwrite');t.objectStore(s).put(d);t.oncomplete=function(){ok()};t.onerror=function(){no(t.error)}})})}
function dbg(s){return odb().then(function(x){return new Promise(function(ok,no){var t=x.transaction(s,'readonly');var r=t.objectStore(s).getAll();r.onsuccess=function(){ok(r.result||[])};r.onerror=function(){no(r.error)}})})}
function dbGet(s,k){return odb().then(function(x){return new Promise(function(ok,no){var t=x.transaction(s,'readonly');var r=t.objectStore(s).get(k);r.onsuccess=function(){ok(r.result)};r.onerror=function(){no(r.error)}})})}

